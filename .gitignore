.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
tests/.DS_Store

# Performance test baselines (session-specific data)
perf-baselines/

# Build-time preprocessed files
.preprocessed/

# Snapshot verification (debug/full JSON files - large, session-specific)
tests/direct-rendering/snapshot-full.json
tests/direct-rendering/snapshot-hashes.json

# BitmapText font assets (fetched on demand via scripts/download-bitmaptext-assets.sh).
# The _smoke/ subset is committed so Node text tests work after a fresh clone.
font-assets/*
!font-assets/.gitkeep
!font-assets/_smoke/
!font-assets/_smoke/**

# BitmapText vendor tree — populated on first build from vendor/bitmaptext.pin
# via scripts/vendor-bitmaptext.sh. The pin file and vendor/bitmaptext.UPDATE.md
# (both siblings, not children of the ignored dir) ARE committed.
# See vendor/bitmaptext.UPDATE.md.
vendor/bitmaptext/
