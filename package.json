{
  "name": "swcanvas",
  "version": "1.0.0",
  "description": "Deterministic 2D raster engine with Canvas-like API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidedc/swcanvas.js.git"
  },
  "homepage": "https://davidedc.github.io/swcanvas.js/",
  "bugs": {
    "url": "https://github.com/davidedc/swcanvas.js/issues"
  },
  "main": "dist/swcanvas.js",
  "scripts": {
    "build": "./build.sh",
    "build:3d-core": "./build-scripts/build-3d-core.sh",
    "minify": "./minify.sh",
    "build:prod": "npm run build && npm run minify",
    "test": "node tests/run-tests.js",
    "test:direct-rendering": "node tests/direct-rendering/run-direct-rendering-tests.js",
    "test:direct-rendering:perf": "node tests/direct-rendering/run-performance-tests.js",
    "check:test-metadata": "node build-scripts/check-test-metadata.js",
    "check:register-consistency": "sh build-scripts/check-register-consistency.sh",
    "update-test-counts": "node tests/build/update-test-counts.js",
    "debug:source-out": "npm run build && node debug-composite-source-out.js",
    "debug:xor": "npm run build && node debug-composite-xor.js",
    "debug:composite": "npm run debug:source-out && npm run debug:xor",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "text:download-assets": "./scripts/download-bitmaptext-assets.sh",
    "text:build-smoke-fixture": "node scripts/build-smoke-fixture.js",
    "text:wrap-for-file": "node vendor/bitmaptext/scripts/image-to-js-converter.js font-assets --webp",
    "text:smoke-demo": "node scripts/smoke-text-demo.js --playwright-from ../BitmapText.js/node_modules/playwright",
    "text:check-pin": "./scripts/check-bitmaptext-release-pinned.sh"
  },
  "keywords": ["canvas", "2d", "deterministic", "raster"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}